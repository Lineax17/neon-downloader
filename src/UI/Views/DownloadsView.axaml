<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UI.ViewModels"
             xmlns:models="using:UI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UI.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">
    <StackPanel Margin="16" Spacing="8">
        <ListBox ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadItem">
                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Url}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding Progress, StringFormat={}{0:F1}%}"
                                   VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Minimum="0" Maximum="100" Value="{Binding Progress}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ErrorMessage}" Foreground="Red"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>