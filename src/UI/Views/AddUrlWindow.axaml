<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UI.ViewModels"
        x:Class="UI.Views.AddUrlWindow"
        x:DataType="vm:AddUrlWindowViewModel"
        Title="URL hinzufügen"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource CardBrush}" Padding="24">
        <StackPanel Spacing="12">
            <TextBlock Text="URL hinzufügen" Classes="h1"/>

            <TextBlock Text="Füge einen Link zur Linkgrabber-Liste hinzu."
                       Classes="muted"
                       TextWrapping="Wrap"/>

            <TextBox Text="{Binding Url}"
                     Watermark="https://example.com/file.zip"
                     Padding="10,9"
                     CornerRadius="8"/>

            <Button Content="Hinzufügen"
                    Classes="accent"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ConfirmCommand}"/>
        </StackPanel>
    </Border>

</Window>